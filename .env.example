# Replace both passwords before the first start, e.g. using: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-database-password
AUTH_USER=admin
AUTH_PASSWORD=replace-with-a-random-admin-password
PORT=8080

# Use false for local HTTP; set to true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
SOURCE_TIMEOUT=20s
REQUEST_TIMEOUT=60s
MAX_FEED_BYTES=10485760

# Explicitly allow only specific internal feed sources, e.g. 192.168.10.15/32.
ALLOWED_NETWORKS=

# Optional: a separate legacy database. If unset, the target database is checked.
# Special characters in a PostgreSQL URL must be URL-encoded.
LEGACY_DATABASE_URL=
