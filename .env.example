# Vor dem ersten Start beide Passwörter ersetzen, z.B. mit: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-database-password
AUTH_USER=admin
AUTH_PASSWORD=replace-with-a-random-admin-password
PORT=8080

# Für lokalen HTTP-Betrieb false; hinter einem HTTPS-Reverse-Proxy auf true setzen.
COOKIE_SECURE=false
SOURCE_TIMEOUT=20s
REQUEST_TIMEOUT=60s
MAX_FEED_BYTES=10485760

# Interne Quellfeeds nur gezielt freigeben, z.B. 192.168.10.15/32.
ALLOWED_NETWORKS=

# Optional: andere alte Datenbank. Ohne Angabe wird die Zieldatenbank geprüft.
# Sonderzeichen in einer PostgreSQL-URL müssen URL-kodiert sein.
LEGACY_DATABASE_URL=
